{
  "manifest_version": 3,
  "name": "Block Reposters for X",
  "version": "1.1.0",
  "description": "Collecte les comptes qui ont reposté un post sur X et les bloque automatiquement, un par un.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*"],
  "action": {
    "default_title": "Block Reposters for X",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
